# TravelWise Environment Configuration Example

# Backend Configuration
PROJECT_NAME="TravelWise – Smart Travel Planning Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Security & Authentication
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY="travelwise-super-secret-jwt-key-change-in-production-random-string-12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql://travelwise_user:travelwise_pass@localhost:5432/travelwise_db
# For SQLite (Local rapid development fallback):
DATABASE_URL=sqlite:///./travelwise.db

# CORS Configuration (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Frontend Configuration (for frontend/.env)
VITE_API_BASE_URL="http://localhost:8000/api"

# Optional but required for live worldwide location discovery, reverse
# geocoding and exact provider-owned photos. Enable Places API (New) and
# Geocoding API for this server-side key.
GOOGLE_MAPS_API_KEY=""
